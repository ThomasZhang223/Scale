# Copy this file to infra/.env and fill in real values. infra/.env is already covered by the
# repo's .gitignore (the blanket ".env" rule) — never commit it.

# Shared secret for X-Upstream-Token, checked by fit, search, and ingest (see
# services/*/app/auth.py). Any random string; the Worker holds the same value in its own
# UPSTREAM_TOKEN secret (`wrangler secret put UPSTREAM_TOKEN`). A quick-tunnel URL is
# unguessable but fully public, so this token is the only thing between the open internet and
# the solver. Every local service raises at startup if this is unset — never leave it blank.
UPSTREAM_TOKEN=

# The Worker this laptop reports its tunnel origins to. This is full-scale-workers, a second
# Worker made for this project — never the existing htn-2026 Worker, which auto-deploys from
# GitHub and would fight a manual `wrangler deploy`.
WORKER_BASE_URL=https://full-scale-workers.thomaszhangdev.workers.dev

# Host ports for the three local services. These must match docker-compose.yml's port
# mappings — infra/up.sh tunnels exactly these. macOS reserves 5000 and 7000 for AirPlay
# Receiver; never put a service on them.
FIT_PORT=8001
SEARCH_PORT=8004
INGEST_PORT=8003
