# Copy this file to infra/.env and fill in real values. infra/.env is already covered by the
# repo's .gitignore (the blanket ".env" rule) — never commit it.

# Shared secret for X-Upstream-Token, checked by fit, search, and ingest (see
# services/*/app/auth.py). Any random string; the Worker holds the same value in its own
# UPSTREAM_TOKEN secret (`wrangler secret put UPSTREAM_TOKEN`). A quick-tunnel URL is
# unguessable but fully public, so this token is the only thing between the open internet and
# the solver. Every local service raises at startup if this is unset — never leave it blank.
UPSTREAM_TOKEN=

# The Worker this laptop reports its tunnel origins to. This is full-scale-workers, a second
# Worker made for this project — never the existing htn-2026 Worker, which auto-deploys from
# GitHub and would fight a manual `wrangler deploy`.
WORKER_BASE_URL=https://full-scale-workers.thomaszhangdev.workers.dev

# Host ports for the four local services. These must match docker-compose.yml's port
# mappings — infra/up.sh tunnels exactly these. macOS reserves 5000 and 7000 for AirPlay
# Receiver; never put a service on them.
FIT_PORT=8001
SEARCH_PORT=8005
INGEST_PORT=8003
EMBEDDING_PORT=8004

# Dedicated internal embedding token; also set Worker secret EMBEDDING_API_KEY.
EMBEDDING_API_KEY=

# --- ingest only (owner: Paul). Added by Paul; ask him, not Thomas, about these three. ---
#
# WARNING: infra/.env is COMMITTED (see commit 502ebab — deliberate, so the whole team shares
# one UPSTREAM_TOKEN). A real vendor key pasted into infra/.env therefore goes into git
# history. Unlike UPSTREAM_TOKEN these are billed third-party credentials on someone's
# personal account, so that is a worse trade than it is for the tunnel token.
#
# There is no clean way around it from this file: compose injects only what env_file and
# environment: hold, and a key exported in your shell does NOT reach the container (verified:
# `BROWSERBASE_API_KEY=x docker compose config` shows no such variable on the ingest service).
# The fix is one line in docker-compose.yml, which is Thomas's file — asked for, not assumed.
# Until it lands, pick one:
#   - fill them in here and accept they are in history (fine while the repo is private), or
#   - skip the container and run ingest directly:
#       cd services/ingest && UPSTREAM_TOKEN=… BROWSERBASE_API_KEY=… OPENAI_API_KEY=… \
#         uvicorn app.main:app --port 8080
#     which is also what build_prebake.py does — it never goes through Docker at all.
# docker-compose passes this file into every container, so the ingest service reads them
# from here. All three are optional: the service starts and answers /health without them,
# and step 1 (regex over /products.json) works regardless. They gate the later steps.

# Step 2.5, the rendered-page pass. Without it /extract returns 503
# "browserbase_unconfigured" for any request with browserbase:true — deliberately, because a
# skipped step 2.5 looks exactly like a merchant having no dimensions, and that is the wrong
# conclusion to hand anyone. GET /health reports {"browserbase": true|false} so you can tell
# which mode a running container is in without making a request that costs a page fetch.
BROWSERBASE_API_KEY=

# Steps 2 and 3, the LLM and VLM passes. Unset, both are skipped and /extract says so in
# stats.llm_skipped rather than failing — they are additive passes over products the cheaper
# steps already missed, so their absence costs recall, not correctness.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: point step 3 (reading dimensions off a diagram image) at a stronger model than
# step 2 uses. Unset, step 3 uses OPENAI_MODEL. Step 3 runs only on products every cheaper
# source failed on, so it is the lowest-volume and hardest read in the pipeline.
OPENAI_VLM_MODEL=
