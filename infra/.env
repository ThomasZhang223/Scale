# Real values, deliberately COMMITTED so every teammate gets them from a clone.
#
# This is normally the file you never commit. It is committed here because the repository is
# PRIVATE, the whole team needs the same token for the tunnel hop to work at all, and passing a
# secret around a group chat at 3am is how it ends up wrong on one machine. The root .gitignore
# still has the blanket ".env" rule; this one file is un-ignored by name.
#
# If the repository is ever made public, this token is burned. Rotate it in two places:
#   1. here
#   2. npx wrangler secret put UPSTREAM_TOKEN   (from workers/)
# EMBEDDING_API_KEY follows the same rule: here, and npx wrangler secret put EMBEDDING_API_KEY.
# They must match or every call from the Worker to this laptop answers 401.

# Shared secret for X-Upstream-Token, checked by fit, search and ingest (services/*/app/auth.py).
# The Worker holds this same value as its UPSTREAM_TOKEN secret — set on the account already.
# A quick-tunnel URL is unguessable but fully public, so this token is the only thing between
# the open internet and the solver. Every local service raises at startup if it is unset.
UPSTREAM_TOKEN=QfDpCGUSfrSqfTzytVMcCmbjFOgpPXrMdGtDUIYEUZ8

# The Worker this laptop reports its tunnel origins to. full-scale-workers is a second Worker
# made for this project — never the existing htn-2026 one, which auto-deploys from GitHub and
# would fight a manual `wrangler deploy`.
WORKER_BASE_URL=https://full-scale-workers.thomaszhangdev.workers.dev

# Host ports for the three local services. These must match docker-compose.yml's port mappings —
# infra/up.sh tunnels exactly these. macOS reserves 5000 and 7000 for AirPlay Receiver.
FIT_PORT=8001
SEARCH_PORT=8005
INGEST_PORT=8003
EMBEDDING_PORT=8004
# The B06 generation adapter (services/gen/app/generate_server.py), added 2026-09-20.
# Not tunnelled by up.sh: its URL is a Worker SECRET (BASETEN_URL), not a KV upstream.
# infra/gen-up.sh starts it and its own tunnel without touching the other four.
GEN_PORT=8006

# Shared secret between the Worker (wrangler secret EMBEDDING_API_KEY) and the embedding
# container. Minted with openssl rand -hex 32; not a Baseten or vendor credential.
EMBEDDING_API_KEY=37750fb8ffbad1c562ebd1495005202c8882e60d4423a7dca0b2f73341d892bc
