# The image runs the service: app/ and requirements.txt, nothing else. Everything below is
# either build-time-only or large, and none of it is COPYed by the Dockerfile — but an
# un-ignored file still gets shipped to the daemon as build context on every build.
#
# Without this file the context is ~32 MB today, and ~280 MB after a --browserbase run.

# Generated by build_prebake.py. Committed today so Ani is unblocked; moves to R2 later.
# ceiling: when prebake/ moves to R2, this line and the .gitignore note both go.
prebake/

# Fetched product pages, ~450 KB each.
.page-cache/

# Build-time and dev-time only.
tests/
samples/
build_prebake.py
verify_merchants.py
probe_page.py
candidates*.json
merchants*.json
*.md

__pycache__/
*.pyc
.pytest_cache/
