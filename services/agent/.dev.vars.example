# Copy to .dev.vars (git-ignored) for `npm run dev`. Deployed: `wrangler secret put <NAME>`.
OPENAI_API_KEY=sk-...
# Optional: route OpenAI calls through Cloudflare AI Gateway.
# AI_GATEWAY_URL=https://gateway.ai.cloudflare.com/v1/<account_id>/<gateway_id>/openai
# CF_AIG_TOKEN=...
# When the agent runs on Cloudflare and the solver on a laptop behind a tunnel:
# SOLVER_URL=https://solver.example.com
