# Where Vite's dev server proxies /v1 (Thomas's Worker under `wrangler dev`).
VITE_API_PROXY=http://127.0.0.1:8787

# 1 (default): every request carries X-Stub: 1 and the Worker answers the committed fixtures.
# Set to 0 once the backend has real logic.
VITE_API_STUB=1

# Room to open at start. Default: the fixture's roomId.
VITE_ROOM_ID=8b371353-29a8-4872-8dce-45b7d50576a7

# Voice (dev only; the deployed Worker uses `wrangler secret put ELEVENLABS_API_KEY` + wrangler.toml [vars]).
# Not VITE_-prefixed on purpose: Vite reads these server-side for its /v1/voice proxy and they never reach the bundle.
# ElevenLabs API key (https://elevenlabs.io/app/settings/api-keys). Missing → /v1/voice answers 501, no fallback.
ELEVENLABS_API_KEY=
# ElevenLabs voice id for spoken replies; default is the premade "George" voice from the ElevenLabs quickstart.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
