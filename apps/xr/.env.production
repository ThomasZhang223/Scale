# Build-time settings for the DEPLOYED headset page. Vite loads this for `vite build` only
# (mode production), so `npm run dev` and a local checkout are untouched, and `?room=<id>` or an
# explicit `VITE_ROOM_ID=… npm run deploy` still wins over it (a set shell variable takes priority).

# Talk to the real backend. Without this a plain `npm run deploy` shipped the STUB build, because
# STUB defaults ON in src/api.ts.
VITE_API_STUB=0

# The demo room: Judging Room H, 2.76 x 4.72 x 2.96 m, all six surfaces photographed.
# fixtures/room-h.json is the same room committed. Change this one line to open a different room.
VITE_ROOM_ID=ccff7dec-1fc1-493e-96e3-3ab6f6ddfb2a

# The rooms the picker offers, in order. Committed config, never a listing of the rooms table:
# that table holds every throwaway and smoke room the panels have made, so "rooms that exist" and
# "rooms worth standing in" are different sets. Malformed or missing -> an empty picker that says
# so, never a guessed room. VITE_ROOM_ID above decides which of these opens first.
VITE_ROOMS=[{"id":"ccff7dec-1fc1-493e-96e3-3ab6f6ddfb2a","label":"Meeting room"},{"id":"b5318133-49d1-4484-88dc-f38cef684175","label":"Skyline room"}]
