node_modules/

# The repository root .gitignore has `lib/` on line 17 — a Node build-artifact rule that also
# matches our source directory workers/src/lib/ and silently drops nine files from every
# commit. A deeper .gitignore wins, and a directory must be re-included before the files
# inside it can be, which is why both lines are here.
!src/lib/
!src/lib/*

.wrangler/
.dev.vars

# Generated by `npm run types` from wrangler.toml. 600 KB of runtime declarations that would
# otherwise churn on every wrangler upgrade. `npm run typecheck` regenerates it first, so a
# fresh clone needs no extra step.
worker-configuration.d.ts

# Generated by infra/cloudflare/offline-config.sh
.wrangler.offline.toml
